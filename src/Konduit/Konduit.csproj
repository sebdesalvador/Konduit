<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Konduit</RootNamespace>
    <AssemblyName>Konduit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Konduit</PackageId>
    <Authors>Sébastien de Salvador</Authors>
    <Copyright>Copyright (c) 2026 Sébastien de Salvador</Copyright>
    <PackageProjectUrl>https://github.com/sebdesalvador/Konduit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sebdesalvador/Konduit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Version>0.4.0</Version>
    <Description>ASP.NET Core style middleware pipelines for any dependency-injected service. Register a service as usual and chain WithMiddleware&lt;T&gt;() to wrap every call in middleware that runs code before and after, with source-generated proxies and no reflection on the call path.</Description>
    <PackageTags>dependency-injection;middleware;interception;aop;source-generator;proxy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The generator ships inside this package, so consumers reference Konduit alone. It is built as a
    dependency but never referenced as an assembly: analyzers load into the compiler, not the app.
  -->
  <ItemGroup>
    <ProjectReference Include="../Konduit.SourceGeneration/Konduit.SourceGeneration.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <Target Name="PackKonduitAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Konduit.SourceGeneration/Konduit.SourceGeneration.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_KonduitAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_KonduitAnalyzerAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
